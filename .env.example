# Copy this file to .env and fill in at least one LLM API key.
# .env is gitignored - never commit real keys.

# ---- LLM providers (fill in what you have) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- Optional: local Ollama on the host machine ----
# OLLAMA_HOST=http://host.docker.internal:11434

# ---- Optional: custom OpenAI-compatible endpoint ----
# OPENAI_COMPATIBLE_ENDPOINT=http://localhost:8080/v1
# OPENAI_COMPATIBLE_API_KEY=

# ---- OpenUI dev settings ----
OPENUI_DEV_MODE=true
OPENUI_PORT=7878
